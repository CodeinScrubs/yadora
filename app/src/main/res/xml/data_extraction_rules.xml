<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ cloud backup and device transfer. See backup_rules.xml for the same reasoning.

  cloud-backup: settings only. The raw Room database is excluded because auto-backup copies the live
  SQLite files without a WAL checkpoint (torn-snapshot risk), and the app's own JSON export/import is
  the supported, tested way to move a study history between phones.

  device-transfer: a direct phone-to-phone copy is taken at a safer moment than an opportunistic
  cloud upload, so the database IS included there — it makes "set up my new phone" carry the user's
  history with no extra steps.

  "medreview_transient" is excluded from BOTH: it is this device's reminder bookkeeping (last fired /
  snoozed until / next nudge), and carrying it across can silence reminders on the new phone.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="."/>
        <exclude domain="sharedpref" path="medreview_transient.xml"/>
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="."/>
        <include domain="sharedpref" path="."/>
        <exclude domain="sharedpref" path="medreview_transient.xml"/>
    </device-transfer>
</data-extraction-rules>
